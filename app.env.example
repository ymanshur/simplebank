DEBUG=true
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,https://api.simplebank.com

DB_SOURCE=postgresql://postgres:postgres@localhost:5432/simplebank?sslmode=disable
DB_MIGRATION_URL=file://db/migration

HTTP_SERVER_ADDRESS=0.0.0.0:8000
GRPC_SERVER_ADDRESS=0.0.0.0:9090
GRPC_GATEWAY_SERVER_ADDRESS=0.0.0.0:8080

TOKEN_SYMMETRIC_KEY=

ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h

REDIS_ADDRESS=0.0.0.0:6379
REDIS_USERNAME=
REDIS_PASSWORD=

EMAIL_SENDER_NAME="Simple Bank"
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_PASSWORD=
